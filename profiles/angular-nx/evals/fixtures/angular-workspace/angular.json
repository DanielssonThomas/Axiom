{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false, "schematicCollections": ["@schematics/angular"] },
  "projects": {
    "catalog-web": {
      "projectType": "application",
      "root": "apps/catalog-web",
      "sourceRoot": "apps/catalog-web/src",
      "prefix": "fixture",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "apps/catalog-web/src/main.ts",
            "index": "apps/catalog-web/src/index.html",
            "outputPath": "dist/catalog-web",
            "tsConfig": "apps/catalog-web/tsconfig.app.json"
          }
        }
      }
    },
    "catalog": {
      "projectType": "library",
      "root": "libs/catalog",
      "sourceRoot": "libs/catalog/src",
      "prefix": "fixture",
      "architect": {
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "catalog-web:build",
            "tsConfig": "libs/catalog/tsconfig.spec.json"
          }
        }
      }
    }
  }
}
