{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "Preserve",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@axiom/contracts": ["./packages/contracts/src/index.ts"],
      "@axiom/claude-adapter": ["./adapters/claude/src/index.ts"],
      "@axiom/codex-adapter": ["./adapters/codex/src/index.ts"],
      "@axiom/hermes-adapter": ["./adapters/hermes/src/index.ts"],
      "@axiom/graders": ["./evals/graders/index.ts"],
      "@axiom/evidence": ["./packages/evidence/src/index.ts"],
      "@axiom/policy": ["./packages/policy/src/index.ts"],
      "@axiom/bundles": ["./packages/bundles/src/index.ts"],
      "@axiom/benchmark": ["./packages/benchmark/src/index.ts"],
      "@axiom/doctor": ["./packages/doctor/src/index.ts"],
      "@axiom/verification": ["./packages/verification/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "adapters/*/src/**/*.ts", "tests/**/*.ts", "vitest.config.mts"]
}
